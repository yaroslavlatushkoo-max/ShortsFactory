# ShortsFactory — multi-provider AI configuration (Mission 4)
#
# Copy this file to `.env` at the project root and fill in only the keys for
# the providers you actually want to use. NEVER commit the real `.env`.
# Secrets are read at runtime and are never written to logs, reports, manifests,
# or source. The pipeline never calls a provider without its key.
#
# IMPORTANT: all cloud providers here are PAID. The pipeline will not make any
# paid call unless you (a) set the key and (b) run without --dry-run. Always
# start with `shortsfactory ai-create ... --dry-run` to see the plan and cost.
#
# PRECEDENCE: real exported environment variables win over values in `.env`.
# A value that is already set in the OS environment is never overwritten by this
# file. One key (e.g. GEMINI_API_KEY) covers multiple Google services (Gemini
# text + Veo video) — the same key is read for both.

# ------------------------------------------------ video generation (paid) ---

# Which video provider the generative pipeline uses. One of:
#   disabled (default — no generative video possible), veo, kling, fal
SHORTSFACTORY_VIDEO_PROVIDER=disabled

# --- Google Veo 3.1 (Gemini API) ---
# Either key works for the Veo backend. Paid.
#GEMINI_API_KEY=
#GOOGLE_API_KEY=
# Optional model override (default: veo-3.1-lite-generate-001)
#GEMINI_VIDEO_MODEL=

# --- Kling AI (official API) ---
# Recommended: a single API Key (Bearer token) from https://kling.ai/dev/api-key
#   -> set KLING_API_KEY (the official SDK also accepts KLINGAI_API_KEY).
# Legacy: Access Key + Secret Key (signed JWT requests). Only used when the
#   modern API key above is absent. Do not mix the two.
# Paid.
#KLING_API_KEY=
#KLINGAI_API_KEY=
#KLING_ACCESS_KEY=
#KLING_SECRET_KEY=
# Optional: override the API base URL (default https://api.klingai.com)
#KLING_BASE_URL=
# Optional model overrides (defaults: kling-v3.0-t2v / kling-v3.0-i2v)
#KLING_TEXT_MODEL=
#KLING_IMAGE_MODEL=

# --- fal.ai aggregator (can host Kling / Veo / others) ---
# Paid.
#FAL_KEY=
#FAL_API_KEY=
# Optional hosted model id on fal (default: fal-ai/kling-video/v3/standard/text-to-video)
#SHORTSFACTORY_FAL_MODEL=

# ------------------------------------------------- text / planning (cloud) ---

# --- Google Gemini (text + structured JSON) ---
# Paid (free-tier availability depends on current Google terms — verify).
#GEMINI_API_KEY=
#GOOGLE_API_KEY=
# Optional model override (default: gemini-2.0-flash)
#GEMINI_TEXT_MODEL=

# --- OpenAI-compatible API (cloud or local, e.g. vLLM/LM Studio) ---
# Set the base URL to use a local/private endpoint; key may then be empty.
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=
#OPENAI_MODEL=

# --- local Ollama (free, offline) ---
#OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model used by the default local text provider:
#OLLAMA_TEXT_MODEL=qwen3:4b

# -------------------------------------------------------------- voice (paid) ---

# --- ElevenLabs TTS ---
# Paid.
#ELEVENLABS_API_KEY=
# Optional voice id (default: 21m00Tcm4TlvDq8ikWAM = Rachel)
#ELEVENLABS_VOICE_ID=
# Local Piper is the default fallback (free, offline) — no key required.
